# SQLite for local. PostgreSQL/Aurora URL in production.
DATABASE_URL=file:./dev.db

# HMAC secret for httpOnly session cookies
APP_SESSION_SECRET=replace-with-32-plus-char-secret

# Comma-separated @valere.io emails granted ADMIN on first login
APP_ADMIN_EMAILS=logan@valere.io

# Shared secret for EventBridge/Lambda cron callbacks
APP_CRON_SECRET=replace-with-cron-secret

# Monday.com API
APP_MONDAY_API_TOKEN=
APP_MONDAY_ACCOUNTS_BOARD_ID=4476095209

# Optional: allow password login for @valere.io in development only
APP_DEV_AUTH=false

# Amazon Bedrock (chat). Leave empty to use extractive fallback.
APP_BEDROCK_REGION=us-east-1
APP_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Google Drive (admin OAuth refresh token stored encrypted)
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=
APP_GOOGLE_REFRESH_TOKEN=
APP_DRIVE_TOKEN_ENCRYPTION_KEY=

# Public app URL
APP_BASE_URL=http://localhost:3000

# AWS account used for Amplify
APP_AWS_ACCOUNT_ID=735948691025

# Cognito token verification for Google Workspace SAML
APP_COGNITO_REGION=us-east-1
APP_COGNITO_USER_POOL_ID=us-east-1_Ct7xz39IV
APP_COGNITO_CLIENT_ID=58p23lr1o6cbm1lh0erhhcljq9
